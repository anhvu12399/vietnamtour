# Sanity CMS Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=knxuvin4
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity Editor/Write API Token (for recording enquire submissions in CMS)
# Create a write token in sanity.io/manage under API Settings
SANITY_WRITE_TOKEN=

# Resend Email Dispatcher API Key (from resend.com)
RESEND_API_KEY=

# IndexNow Configuration
# The verification key hosted at the root of the site (e.g. public/<key>.txt)
INDEXNOW_KEY=bfb03d52674e47be91307b22a00c6d5b
# The hostname of the production site (without protocol)
INDEXNOW_HOST=vietnamtour.co.uk
# The secret token used to authorize incoming webhook triggers
INDEXNOW_SECRET=


# ── GEO / SEO (all optional; never put invented values here) ────────────────
NEXT_PUBLIC_SITE_URL=https://www.vietnamtours.co.uk

# Webmaster verification (Bing's index feeds ChatGPT Search)
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# IndexNow key is configured above (INDEXNOW_KEY). It is also served at /api/indexnow/key
# and used as keyLocation. INDEXNOW_SECRET authorises the Sanity webhook:
#   POST /api/indexnow?secret=<INDEXNOW_SECRET>

# Entity data — ONLY real, verifiable values. They are emitted in JSON-LD when set.
# Comma-separated profile URLs: TripAdvisor, Trustpilot, LinkedIn, YouTube, Wikidata…
NEXT_PUBLIC_SAME_AS=
NEXT_PUBLIC_UK_PHONE=
NEXT_PUBLIC_UK_STREET=
NEXT_PUBLIC_UK_POSTCODE=
NEXT_PUBLIC_FOUNDING_YEAR=
# "ABTA:Y1234,ATOL:1234" (name:number). Leave empty unless you hold the membership.
NEXT_PUBLIC_MEMBERSHIPS=
# Only if it matches a public review profile you can link to
NEXT_PUBLIC_RATING_VALUE=
NEXT_PUBLIC_RATING_COUNT=

# Set to "false" to block model-training crawlers (GPTBot, ClaudeBot, Google-Extended…).
# Search crawlers (OAI-SearchBot, ChatGPT-User, Bingbot…) stay allowed.
GEO_ALLOW_AI_TRAINING=true
