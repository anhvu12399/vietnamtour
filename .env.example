# ── GEO / SEO (all optional; never put invented values here) ────────────────
NEXT_PUBLIC_SITE_URL=https://www.vietnamtours.co.uk

# Webmaster verification (Bing's index feeds ChatGPT Search)
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# IndexNow: any 8–128 char string (a-z A-Z 0-9 -). The key is served at /api/indexnow/key
INDEXNOW_KEY=
# Shared secret for the Sanity webhook → POST /api/indexnow?secret=…
INDEXNOW_WEBHOOK_SECRET=

# Entity data — ONLY real, verifiable values. They are emitted in JSON-LD when set.
# Comma-separated profile URLs: TripAdvisor, Trustpilot, LinkedIn, YouTube, Wikidata…
NEXT_PUBLIC_SAME_AS=
NEXT_PUBLIC_UK_PHONE=
NEXT_PUBLIC_UK_STREET=
NEXT_PUBLIC_UK_POSTCODE=
NEXT_PUBLIC_FOUNDING_YEAR=
# "ABTA:Y1234,ATOL:1234" (name:number). Leave empty unless you hold the membership.
NEXT_PUBLIC_MEMBERSHIPS=
# Only if it matches a public review profile you can link to
NEXT_PUBLIC_RATING_VALUE=
NEXT_PUBLIC_RATING_COUNT=

# Set to "false" to block model-training crawlers (GPTBot, ClaudeBot, Google-Extended…).
# Search crawlers (OAI-SearchBot, ChatGPT-User, Bingbot…) stay allowed.
GEO_ALLOW_AI_TRAINING=true
