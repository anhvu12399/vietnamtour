# Sanity CMS Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=knxuvin4
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity Editor/Write API Token (for recording enquire submissions in CMS)
# Create a write token in sanity.io/manage under API Settings
SANITY_WRITE_TOKEN=

# Resend Email Dispatcher Configuration (from resend.com)
# When set, customer receives a luxury auto-reply thank-you email and team receives notification.
RESEND_API_KEY=
# Verified sender domain (e.g. Vietnam Tours <concierge@vietnamtour.co.uk> or onboarding@resend.dev)
RESEND_FROM_EMAIL=Vietnam Tours <concierge@vietnamtour.co.uk>
# Customer reply-to address
RESEND_REPLY_TO=info@vietnamtours.co.uk
# Admin notification recipient
NOTIFICATION_EMAIL=mywaytravelinc@gmail.com

# IndexNow Configuration
# The verification key hosted at the root of the site (e.g. public/<key>.txt)
INDEXNOW_KEY=bfb03d52674e47be91307b22a00c6d5b
# The hostname of the production site (without protocol)
INDEXNOW_HOST=vietnamtour.co.uk
# The secret token used to authorize incoming webhook triggers
INDEXNOW_SECRET=

